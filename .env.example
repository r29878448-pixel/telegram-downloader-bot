# Required (both are needed for the local Bot API server in docker-compose)
BOT_TOKEN=123456:ABC-your-token-here
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# Optional:
ALLOWED_IDS=123456789            # only this user can use the bot (empty = everyone)
MEGA_EMAIL=you@example.com       # Mega Pro login — raises quota (password also required)
MEGA_PASSWORD=your-password
MAX_CONCURRENT_JOBS=3            # how many download jobs run at once
